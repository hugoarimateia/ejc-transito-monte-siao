# ==============================================================================
# VARIÁVEIS DE AMBIENTE - EJC TRÂNSITO MONTE SIÃO
# Configure estas variáveis no painel da Vercel (Settings > Environment Variables)
# e no Supabase (Settings > API / Edge Functions Secrets).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VARIÁVEIS PÚBLICAS (Acessíveis pelo Frontend e geradas no build)
# ------------------------------------------------------------------------------
# URL do projeto Supabase (ex.: https://seu-projeto.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública/anônima do Supabase (publishable key ou anon key JWT)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Dados opcionais de infraestrutura (Preço e WhatsApp são configurados pelo ADMIN no painel /admin/)
# NÃO defina NEXT_PUBLIC_PIX_VALOR_INSCRICAO para que o preço venha sempre do banco de dados (persistência oficial).
NEXT_PUBLIC_PIX_CHAVE=
NEXT_PUBLIC_PIX_TIPO_CHAVE=
NEXT_PUBLIC_PIX_BENEFICIARIO=
NEXT_PUBLIC_PIX_CIDADE=
NEXT_PUBLIC_PIX_EXPIRACAO_MINUTOS=15

# WhatsApp é 100% gerenciado no painel administrativo (/admin/ > WhatsApp)
NEXT_PUBLIC_WHATSAPP_VERDE=
NEXT_PUBLIC_WHATSAPP_VERMELHO=
NEXT_PUBLIC_WHATSAPP_AMARELO=
NEXT_PUBLIC_WHATSAPP_LARANJA=
NEXT_PUBLIC_WHATSAPP_GERAL=

# Chave Pública do Mercado Pago (Frontend / Card Payment Brick)
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=

# ------------------------------------------------------------------------------
# 2. VARIÁVEIS PRIVADAS / SERVER-ONLY (Acessíveis APENAS em /api/ e Edge Functions)
# NUNCA EXPOR ESTAS VARIÁVEIS NO FRONTEND!
# ------------------------------------------------------------------------------
# Chave mestra de serviço do Supabase. OBRIGATÓRIA: todas as APIs dependem dela para ler/gravar
# inscrições e pagamentos (o navegador não tem acesso direto a essas tabelas por segurança RLS).
SUPABASE_SERVICE_ROLE_KEY=

# Segredo de validação do Webhook do Gateway Pix. OBRIGATÓRIO para autenticar webhooks.
# Configure a URL de notificação no gateway como: https://transitoejc.site/api/pix-webhook?secret=SEU_SEGREDO
PIX_WEBHOOK_SECRET=

# Senhas do Painel Administrativo (/admin/). Ficam SOMENTE no servidor (nunca no código).
# Super Admin / Coordenação Geral (acesso total com permissões financeiras, aprovação e WhatsApp):
ADMIN_PASSWORD_COORDENACAO=transito2026tt

# Gestor financeiro (edita valores, chave Pix e aprova pagamentos):
ADMIN_PASSWORD_FINANCEIRO=

# Administrador geral (visualização de inscrições e links de WhatsApp):
ADMIN_PASSWORD=

# Gateway de Pagamento (Mercado Pago)
MERCADOPAGO_ACCESS_TOKEN=
GATEWAY_PIX_API_KEY=

# E-mail transacional (Brevo v3 API)
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=EJC — AD Monte Sião
BREVO_ADMIN_EMAIL=

# URL oficial de produção
SITE_URL=https://transitoejc.site
