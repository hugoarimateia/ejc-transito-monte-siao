# ==============================================================================
# VARIÁVEIS DE AMBIENTE - EJC TRÂNSITO MONTE SIÃO
# Configure estas variáveis no painel da Vercel (Settings > Environment Variables)
# e no Supabase (Settings > API / Edge Functions Secrets).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VARIÁVEIS PÚBLICAS (Acessíveis pelo Frontend e geradas no build)
# ------------------------------------------------------------------------------
# URL do projeto Supabase (ex.: https://seu-projeto.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública/anônima do Supabase (anon key com formato JWT seguro)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Dados oficiais do Pix para recebimento de contribuições
NEXT_PUBLIC_PIX_CHAVE=leoeuler03@gmail.com
NEXT_PUBLIC_PIX_TIPO_CHAVE=EMAIL
NEXT_PUBLIC_PIX_BENEFICIARIO=EJC TRANSITO MONTE SIAO
NEXT_PUBLIC_PIX_CIDADE=CAMPINA GRANDE
NEXT_PUBLIC_PIX_VALOR_INSCRICAO=50.00
NEXT_PUBLIC_PIX_EXPIRACAO_MINUTOS=15

# Links dos grupos de WhatsApp por Sub
NEXT_PUBLIC_WHATSAPP_VERDE=https://chat.whatsapp.com/F0aBlRgma3LDGFFG9WrZF6?sub=verde
NEXT_PUBLIC_WHATSAPP_VERMELHO=https://chat.whatsapp.com/F0aBlRgma3LDGFFG9WrZF6?sub=vermelho
NEXT_PUBLIC_WHATSAPP_AMARELO=https://chat.whatsapp.com/F0aBlRgma3LDGFFG9WrZF6?sub=amarelo
NEXT_PUBLIC_WHATSAPP_AZUL=https://chat.whatsapp.com/F0aBlRgma3LDGFFG9WrZF6?sub=azul
NEXT_PUBLIC_WHATSAPP_GERAL=https://chat.whatsapp.com/F0aBlRgma3LDGFFG9WrZF6?s=cl&p=i&mlu=0

# ------------------------------------------------------------------------------
# 2. VARIÁVEIS PRIVADAS / SERVER-ONLY (Acessíveis APENAS em /api/ e Edge Functions)
# NUNCA EXPOR ESTAS VARIÁVEIS NO FRONTEND!
# ------------------------------------------------------------------------------
# Chave mestra de serviço do Supabase (para operações administrativas e webhooks)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Segredo de validação do Webhook do Gateway Pix
PIX_WEBHOOK_SECRET=seu_webhook_secret_aqui

# Senha de autenticação do Painel Administrativo (/admin/)
ADMIN_ACCESS_PASSWORD=ejc2026

# Token do Gateway Pix (Mercado Pago, Efí Pay ou Asaas) se integrado via API
GATEWAY_PIX_API_KEY=seu_token_de_producao_do_gateway
